{
  "$schema": "https://sugon-cloud-skillui.local/schemas/sugon.tokens.json",
  "$description": "曙光云 SkillUI brand tokens — single source of truth. Run npm run build:kit to regenerate CSS / DESIGN.md frontmatter / registry theme / playground JSON.",
  "meta": {
    "name": "sugon-brand-kit",
    "brand": "曙光云",
    "version": "0.3.1",
    "primary": "#C8161D"
  },
  "color": {
    "primary": {
      "$value": "#C8161D",
      "$type": "color",
      "$css": "--color-primary"
    },
    "primary-hover": {
      "$value": "#A81218",
      "$type": "color",
      "$css": "--color-primary-hover"
    },
    "primary-active": {
      "$value": "#8F0F14",
      "$type": "color",
      "$css": "--color-primary-active"
    },
    "primary-foreground": {
      "$value": "#ffffff",
      "$type": "color",
      "$css": "--color-primary-foreground"
    },
    "primary-muted": {
      "$value": "#FCE8E9",
      "$type": "color",
      "$css": "--color-primary-muted"
    },
    "accent": {
      "$value": "#C8161D",
      "$type": "color",
      "$css": "--color-accent"
    },
    "accent-hover": {
      "$value": "#A81218",
      "$type": "color",
      "$css": "--color-accent-hover"
    },
    "accent-muted": {
      "$value": "#FCE8E9",
      "$type": "color",
      "$css": "--color-accent-muted"
    },
    "bg": {
      "$value": "#ffffff",
      "$type": "color",
      "$css": "--color-bg"
    },
    "bg-subtle": {
      "$value": "#fafafa",
      "$type": "color",
      "$css": "--color-bg-subtle"
    },
    "bg-muted": {
      "$value": "#f4f4f5",
      "$type": "color",
      "$css": "--color-bg-muted"
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$css": "--color-surface"
    },
    "border": {
      "$value": "#e5e5e5",
      "$type": "color",
      "$css": "--color-border"
    },
    "border-strong": {
      "$value": "#d4d4d4",
      "$type": "color",
      "$css": "--color-border-strong"
    },
    "text": {
      "$value": "#171717",
      "$type": "color",
      "$css": "--color-text"
    },
    "text-secondary": {
      "$value": "#525252",
      "$type": "color",
      "$css": "--color-text-secondary"
    },
    "text-muted": {
      "$value": "#a3a3a3",
      "$type": "color",
      "$css": "--color-text-muted"
    },
    "text-inverse": {
      "$value": "#ffffff",
      "$type": "color",
      "$css": "--color-text-inverse"
    },
    "success": {
      "$value": "#059669",
      "$type": "color",
      "$css": "--color-success"
    },
    "warning": {
      "$value": "#d97706",
      "$type": "color",
      "$css": "--color-warning"
    },
    "danger": {
      "$value": "#C8161D",
      "$type": "color",
      "$css": "--color-danger"
    },
    "danger-muted": {
      "$value": "#FEF2F2",
      "$type": "color",
      "$css": "--color-danger-muted"
    },
    "danger-border": {
      "$value": "#FECACA",
      "$type": "color",
      "$css": "--color-danger-border"
    },
    "danger-foreground": {
      "$value": "#B91C1C",
      "$type": "color",
      "$css": "--color-danger-foreground"
    }
  },
  "focus": {
    "ring": {
      "$value": "0 0 0 3px var(--color-primary-muted)",
      "$type": "other",
      "$css": "--focus-ring"
    },
    "ring-strong": {
      "$value": "0 0 0 3px color-mix(in srgb, var(--color-primary) 28%, transparent)",
      "$type": "other",
      "$css": "--focus-ring-strong"
    }
  },
  "topbar": {
    "bg": {
      "$value": "color-mix(in srgb, var(--color-surface) 3%, transparent)",
      "$type": "other",
      "$css": "--topbar-bg"
    },
    "bg-fallback": {
      "$value": "var(--color-surface)",
      "$type": "alias",
      "$css": "--topbar-bg-fallback"
    },
    "blur": {
      "$value": "saturate(180%) blur(20px)",
      "$type": "other",
      "$css": "--topbar-blur"
    },
    "border": {
      "$value": "color-mix(in srgb, var(--color-border) 70%, transparent)",
      "$type": "other",
      "$css": "--topbar-border"
    }
  },
  "font": {
    "sans": {
      "$value": "\"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "$type": "other",
      "$css": "--font-sans"
    },
    "mono": {
      "$value": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "$type": "other",
      "$css": "--font-mono"
    }
  },
  "text": {
    "xs": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$css": "--text-xs"
    },
    "sm": {
      "$value": "0.875rem",
      "$type": "dimension",
      "$css": "--text-sm"
    },
    "base": {
      "$value": "1rem",
      "$type": "dimension",
      "$css": "--text-base"
    },
    "lg": {
      "$value": "1.125rem",
      "$type": "dimension",
      "$css": "--text-lg"
    },
    "xl": {
      "$value": "1.25rem",
      "$type": "dimension",
      "$css": "--text-xl"
    },
    "2xl": {
      "$value": "1.5rem",
      "$type": "dimension",
      "$css": "--text-2xl"
    },
    "3xl": {
      "$value": "1.875rem",
      "$type": "dimension",
      "$css": "--text-3xl"
    },
    "4xl": {
      "$value": "2.25rem",
      "$type": "dimension",
      "$css": "--text-4xl"
    },
    "5xl": {
      "$value": "3rem",
      "$type": "dimension",
      "$css": "--text-5xl"
    },
    "6xl": {
      "$value": "3.75rem",
      "$type": "dimension",
      "$css": "--text-6xl"
    }
  },
  "leading": {
    "tight": {
      "$value": "1.25",
      "$type": "other",
      "$css": "--leading-tight"
    },
    "snug": {
      "$value": "1.375",
      "$type": "other",
      "$css": "--leading-snug"
    },
    "normal": {
      "$value": "1.5",
      "$type": "other",
      "$css": "--leading-normal"
    },
    "relaxed": {
      "$value": "1.625",
      "$type": "other",
      "$css": "--leading-relaxed"
    }
  },
  "tracking": {
    "tight": {
      "$value": "-0.025em",
      "$type": "dimension",
      "$css": "--tracking-tight"
    },
    "normal": {
      "$value": "0",
      "$type": "dimension",
      "$css": "--tracking-normal"
    }
  },
  "fontWeight": {
    "normal": {
      "$value": "400",
      "$type": "other",
      "$css": "--font-weight-normal"
    },
    "medium": {
      "$value": "500",
      "$type": "other",
      "$css": "--font-weight-medium"
    },
    "semibold": {
      "$value": "600",
      "$type": "other",
      "$css": "--font-weight-semibold"
    },
    "bold": {
      "$value": "700",
      "$type": "other",
      "$css": "--font-weight-bold"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.375rem",
      "$type": "dimension",
      "$css": "--radius-sm"
    },
    "md": {
      "$value": "0.5rem",
      "$type": "dimension",
      "$css": "--radius-md"
    },
    "lg": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$css": "--radius-lg"
    },
    "xl": {
      "$value": "1rem",
      "$type": "dimension",
      "$css": "--radius-xl"
    },
    "2xl": {
      "$value": "1.5rem",
      "$type": "dimension",
      "$css": "--radius-2xl"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$css": "--radius-full"
    }
  },
  "space": {
    "1": {
      "$value": "0.25rem",
      "$type": "dimension",
      "$css": "--space-1"
    },
    "2": {
      "$value": "0.5rem",
      "$type": "dimension",
      "$css": "--space-2"
    },
    "3": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$css": "--space-3"
    },
    "4": {
      "$value": "1rem",
      "$type": "dimension",
      "$css": "--space-4"
    },
    "5": {
      "$value": "1.25rem",
      "$type": "dimension",
      "$css": "--space-5"
    },
    "6": {
      "$value": "1.5rem",
      "$type": "dimension",
      "$css": "--space-6"
    },
    "8": {
      "$value": "2rem",
      "$type": "dimension",
      "$css": "--space-8"
    },
    "10": {
      "$value": "2.5rem",
      "$type": "dimension",
      "$css": "--space-10"
    },
    "12": {
      "$value": "3rem",
      "$type": "dimension",
      "$css": "--space-12"
    },
    "16": {
      "$value": "4rem",
      "$type": "dimension",
      "$css": "--space-16"
    },
    "20": {
      "$value": "5rem",
      "$type": "dimension",
      "$css": "--space-20"
    },
    "24": {
      "$value": "6rem",
      "$type": "dimension",
      "$css": "--space-24"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px 0 rgb(23 23 23 / 0.05)",
      "$type": "other",
      "$css": "--shadow-sm"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(23 23 23 / 0.08), 0 2px 4px -2px rgb(23 23 23 / 0.06)",
      "$type": "other",
      "$css": "--shadow-md"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(23 23 23 / 0.08), 0 4px 6px -4px rgb(23 23 23 / 0.05)",
      "$type": "other",
      "$css": "--shadow-lg"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(23 23 23 / 0.1), 0 8px 10px -6px rgb(23 23 23 / 0.06)",
      "$type": "other",
      "$css": "--shadow-xl"
    }
  },
  "btn": {
    "height": {
      "$value": "2.75rem",
      "$type": "dimension",
      "$css": "--btn-height"
    },
    "px": {
      "$value": "1.25rem",
      "$type": "dimension",
      "$css": "--btn-px"
    },
    "radius": {
      "$value": "var(--radius-lg)",
      "$type": "alias",
      "$css": "--btn-radius"
    },
    "font-size": {
      "$value": "var(--text-sm)",
      "$type": "alias",
      "$css": "--btn-font-size"
    },
    "font-weight": {
      "$value": "var(--font-weight-semibold)",
      "$type": "alias",
      "$css": "--btn-font-weight"
    },
    "transition": {
      "$value": "background-color 150ms ease, box-shadow 150ms ease, transform 100ms ease, border-color 150ms ease",
      "$type": "other",
      "$css": "--btn-transition"
    }
  },
  "layout": {
    "container_max": {
      "$value": "80rem",
      "$type": "dimension",
      "$css": "--container-max"
    },
    "container_pad_inline": {
      "$value": "var(--space-4)",
      "$type": "alias",
      "$css": "--container-pad-inline"
    },
    "section_py": {
      "$value": "var(--space-20)",
      "$type": "alias",
      "$css": "--section-py"
    },
    "agent_max": {
      "$value": "80rem",
      "$type": "dimension",
      "$css": "--agent-max"
    }
  },
  "shadcn": {
    "$description": "Mapping onto shadcn/ui standard theme tokens (https://ui.shadcn.com/docs/theming). Values are {group.key} references into this file, or literal CSS. Emitted by build-kit into registry.json item sugon-theme (cssVars.theme/light). Light only; dark is left to the host project.",
    "theme": {
      "radius-sm": "calc(var(--radius) * 0.6)",
      "radius-md": "calc(var(--radius) * 0.8)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) * 1.4)",
      "radius-2xl": "calc(var(--radius) * 1.8)",
      "radius-3xl": "calc(var(--radius) * 2.2)",
      "radius-4xl": "calc(var(--radius) * 2.6)"
    },
    "light": {
      "radius": "{radius.lg}",
      "background": "{color.bg}",
      "foreground": "{color.text}",
      "card": "{color.surface}",
      "card-foreground": "{color.text}",
      "popover": "{color.surface}",
      "popover-foreground": "{color.text}",
      "primary": "{color.primary}",
      "primary-foreground": "{color.primary-foreground}",
      "secondary": "{color.bg-muted}",
      "secondary-foreground": "{color.text}",
      "muted": "{color.bg-muted}",
      "muted-foreground": "{color.text-secondary}",
      "accent": "{color.bg-muted}",
      "accent-foreground": "{color.text}",
      "destructive": "{color.danger-foreground}",
      "border": "{color.border}",
      "input": "{color.border-strong}",
      "ring": "{color.primary}",
      "sidebar": "{color.bg-subtle}",
      "sidebar-foreground": "{color.text}",
      "sidebar-primary": "{color.primary}",
      "sidebar-primary-foreground": "{color.primary-foreground}",
      "sidebar-accent": "{color.bg-muted}",
      "sidebar-accent-foreground": "{color.text}",
      "sidebar-border": "{color.border}",
      "sidebar-ring": "{color.primary}"
    }
  }
}
